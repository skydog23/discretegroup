<project name="discrete group project" default="dist" basedir=".">
    <description>
        discretegroup build file
    </description>
  
  <!-- set global properties for this build -->
  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="dist" location="dist"/>
  <property name="apidoc" location="doc/apidocs"/>
  <property name="stdlib" location="lib"/>
	<property name="weblib" location="/homes/geometer/gunn/WWW/webstart/jars-current"/>
  
  <target name="init">
    <mkdir dir="${build}"/>
    <mkdir dir="${dist}"/>
  </target>

  <target name="core" depends="init" description="compile the source " >
    <javac source="1.6" target="1.6" verbose="false" excludesfile="excludes.txt" srcdir="${src}" destdir="${build}" 
   	classpath="../jreality/release/jReality.jar:
      	../jreality/dist/jReality-tutorial.jar:
         ../jreality/lib/jrworkspace.jar:
    	../jreality/lib/jogl-all.jar:
    	${stdlib}/anim.jar:
     	${stdlib}/projgeom.jar:
   	../stdlib/anim.jar" debug="true" debuglevel="source,lines,vars">
      <compilerarg line="-source 1.6" />
    </javac>
     <copy todir="build"> <!-- copy shader progs -->
        <fileset dir="${src}">
          <exclude name="**/*.java"/>
          <exclude name="**/*.gif"/>
        </fileset>
      </copy>
  </target>

  <target name="dist" depends="core" description="generate the distribution" >
    <jar jarfile="${dist}/discretegroup.jar" basedir="${build}"/>
  		<copy todir="${stdlib}">
  		<fileset file="${dist}/discretegroup.jar">
  		</fileset>
  	</copy>
  </target>

  <target name="javadoc">
    <javadoc destdir="${apidoc}" author="true" version="true" use="true" windowtitle="Template Project API">
      <packageset dir="src" defaultexcludes="yes">
        <include name="de/**" />
      </packageset>
    </javadoc>
  </target>

  <target name="clean">
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
    <delete dir="${apidoc}"/>
  </target>
  
</project>
